FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (2111.72 0 0);

boundaryField
{
    farfield_upstream
    {
        type            fixedValue;
        value           uniform (2111.72 0 0);
    }
    farfield_outer
    {
        type            fixedValue;
        value           uniform (2111.72 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    wall_nose
    {
        type            noSlip;
    }
    wall_cone
    {
        type            noSlip;
    }
    wall_base
    {
        type            noSlip;
    }
    frontWedge
    {
        type            wedge;
    }
    backWedge
    {
        type            wedge;
    }
    defaultFaces
    {
        type            zeroGradient;
    }
}

