FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      collapseDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Standard OpenFOAM collapseDict template (from OpenFOAM-2.3.x source tree),
// used to collapse the degenerate near-axis faces produced by rotational
// extrusion (points at/near r=0 sweep into zero/near-zero-area faces).

controlMeshQuality      off;

collapseEdgesCoeffs
{
    minimumEdgeLength   1e-6;
    maximumMergeAngle   30;
}

collapseFacesCoeffs
{
    initialFaceLengthFactor                 0.5;
    maxCollapseFaceToPointSideLengthCoeff   0.3;
    allowEarlyCollapseToPoint               on;
    allowEarlyCollapseCoeff                 0.2;
    guardFraction                           0.1;
}

controlMeshQualityCoeffs
{
    #include "meshQualityDict"

    edgeReductionFactor         0.5;
    faceReductionFactor         0.5;
    maximumSmoothingIterations  2;
    maximumIterations           10;
    maxPointErrorCount          5;
}

