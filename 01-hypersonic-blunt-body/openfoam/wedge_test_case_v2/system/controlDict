FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Minimal placeholder controlDict - required for OpenFOAM's Time object
// to initialize even for non-time-stepping utilities like gmshToFoam.
// Will be replaced with real solver settings once we reach the
// rhoCentralFoam solver-setup stage.

application     rhoCentralFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         0.00001;

deltaT          0.0000001;

writeControl    timeStep;
writeInterval   1;

purgeWrite      0;

writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

// ************************************************************************* //
