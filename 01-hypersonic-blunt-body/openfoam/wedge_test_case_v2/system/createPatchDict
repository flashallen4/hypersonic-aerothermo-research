FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Retype axis (defaultFaces -> empty) and wedge faces (patch -> wedge),
// matching OpenFOAM's documented axisymmetric convention.

pointSync false;

patches
(
    {
        name            axis;
        patchInfo
        {
            type            empty;
        }
        constructFrom   patches;
        patches         (defaultFaces);
    }
    {
        name            frontWedge;
        patchInfo
        {
            type            wedge;
        }
        constructFrom   patches;
        patches         (frontWedge);
    }
    {
        name            backWedge;
        patchInfo
        {
            type            wedge;
        }
        constructFrom   patches;
        patches         (backWedge);
    }
);

