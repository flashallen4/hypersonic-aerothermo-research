FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 226.5;

boundaryField
{
    farfield_upstream
    {
        type            fixedValue;
        value           uniform 226.5;
    }
    farfield_outer
    {
        type            fixedValue;
        value           uniform 226.5;
    }
    outlet
    {
        type            zeroGradient;
    }
    wall_nose
    {
        type            fixedValue;
        value           uniform 300;
    }
    wall_cone
    {
        type            fixedValue;
        value           uniform 300;
    }
    wall_base
    {
        type            fixedValue;
        value           uniform 300;
    }
    frontWedge
    {
        type            wedge;
    }
    backWedge
    {
        type            wedge;
    }
    defaultFaces
    {
        type            zeroGradient;
    }
}

